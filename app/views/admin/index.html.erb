
<div class="container mt-5">
  <h3 class="text-dark mb-4">Painel de Administração</h3>
  
  <div class="row">
    <%=
      [
        link: '/admin/projects', icon: 'fa-university', title: 'Cadastro Empresas' ,
        link: '/users', icon: 'fa-user-circle-o', title: 'Cadastrar Usuários' ,
        link: '/cliente/register', icon: 'fa-user-circle', title: 'Cadastrar Analistas' ,
        link: '/settings', icon: 'fa-cogs', title: 'Configurações' ,
        link: '/settings/plugin/funny_plugin', icon: 'fa-calendar', title: 'Definir data Coleta'
      ].each do |item|
    %>
      <div class="col-md-4 mb-4">
        <div class="card text-center border-0 shadow rounded-4 h-100 hover-shadow" style="background-color: #f8f9fa;">
          <div class="card-body d-flex flex-column justify-content-center align-items-center">
            <a href="<%= item[:link] %>">
              <i class="fa <%= item[:icon] %> mb-3" style="font-size: 2.5rem; color: #212529;"></i>
            </a>
            <a href="<%= item[:link] %>" class="text-decoration-none text-dark">
              <h5 class="card-title"><%= item[:title] %></h5>
            </a>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<style>
  .hover-shadow:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease-in-out;
  }

  .card i:hover {
    color: #0d6efd !important; /* Bootstrap primary */
    transition: color 0.2s;
  }
</style>












