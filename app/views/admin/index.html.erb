<div class="container mt-5">
  <h3 class="text-dark mb-4">Painel de Administração</h3>

  <div class="row">
    <% [
      { link: '/admin/projects', icon: 'fa-university', title: 'Administrar Empresas', subtitle: 'Gerencie suas empresas parceiras', color: 'bg-primary' },
      { link: '/users', icon: 'fa-user-circle-o', title: 'Administrar Usuários', subtitle: 'Gerencie os usuários do sistema', color: 'bg-success' },
      { link: '/cliente/register', icon: 'fa-user-circle', title: 'Cadastro de Analistas', subtitle: 'Faça aqui o cadastro dos Analistas', color: 'bg-warning' },
      { link: '/settings', icon: 'fa-cogs', title: 'Configurações', subtitle: 'Configurações gerais do sistema', color: 'bg-dark' },
      { link: '/settings/plugin/funny_plugin', icon: 'fa-calendar', title: 'Data das Coletas', subtitle: 'Definir datas de coletas com Anatel', color: 'bg-info' },
      { link: '/reports', icon: 'fa-file-text', title: 'Relatórios', subtitle: 'Gerar relatórios das coletas', color: 'bg-danger' }
    ].each do |item| %>
      <div class="col-md-4 mb-4">
        <div class="card text-white <%= item[:color] %> shadow-lg h-100 rounded-4 hover-shadow" style="min-height: 220px;">
          <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
            <a href="<%= item[:link] %>" class="text-white text-decoration-none">
              <i class="fa <%= item[:icon] %> mb-3" style="font-size: 3rem;"></i>
              <h5 class="fw-bold"><%= item[:title] %></h5>
              <p class="mb-0"><%= item[:subtitle] %></p>
            </a>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<style>
 .card {
  position: relative; /* Evitar que algum outro elemento sobreponha */
}

.card-body {
  background-color: transparent; /* Garantir que não sobreponha com fundo branco */
  color: white; /* Assegura que o texto dentro do card tenha contraste */
}

.card-body a {
  color: white; /* Garantir que os links fiquem visíveis */
}

.card i {
  color: white; /* Garantir que os ícones também fiquem brancos */
}

.hover-shadow:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease-in-out;
}

</style>
