
<div class="container mt-5">
  <h3 class="text-dark mb-4">Painel de Administração</h3>

  <div class="row">
    <%= [
      {
        link: '/admin/projects',
        icon: 'fa-university',
        title: 'Administrar Empresas',
        subtitle: 'Gerencie suas empresas parceiras',
        color: 'bg-primary'
      },
      {
        link: '/users',
        icon: 'fa-user-circle-o',
        title: 'Administrar Usuários',
        subtitle: 'Gerencie os usuários do sistema',
        color: 'bg-success'
      },
      {
        link: '/cliente/register',
        icon: 'fa-user-circle',
        title: 'Cadastro de Analistas',
        subtitle: 'Faça aqui o cadastro dos Analistas',
        color: 'bg-warning'
      },
      {
        link: '/settings',
        icon: 'fa-cogs',
        title: 'Configurações',
        subtitle: 'Configurações gerais do sistema',
        color: 'bg-dark'
      },
      {
        link: '/settings/plugin/funny_plugin',
        icon: 'fa-calendar',
        title: 'Data das Coletas',
        subtitle: 'Definir datas de coletas com Anatel',
        color: 'bg-info'
      },
      {
        link: '/reports',
        icon: 'fa-file-text',
        title: 'Relatórios',
        subtitle: 'Gerar relatórios das coletas',
        color: 'bg-danger'
      }
    ].each do |item| %>
      <div class="col-md-4 mb-4">
        <div class="card text-white <%= item[:color] %> shadow-lg rounded-4 h-100 hover-shadow" style="min-height: 220px;">
          <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">
            <a href="<%= item[:link] %>">
              <i class="fa <%= item[:icon] %> mb-3" style="font-size: 3rem; color: white;"></i>
            </a>
            <a href="<%= item[:link] %>" class="text-white text-decoration-none">
              <h5 class="card-title fw-bold"><%= item[:title] %></h5>
              <p class="card-subtitle"><%= item[:subtitle] %></p>
            </a>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<style>
  .hover-shadow:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease-in-out;
  }

  .card i:hover {
    opacity: 0.8;
    transform: scale(1.1);
    transition: 0.2s ease-in-out;
  }
</style>





