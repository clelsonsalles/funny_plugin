<div class="container-fluid mt-5">

  <div class="mb-4">
    <h3><strong><%= @organizacao.nome %></strong></h3>
  </div>

  <!-- DADOS DA EMPRESA -->
  <div class="card shadow-sm rounded-3 mb-4">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">Dados da Empresa</h5>
    </div>
    <div class="card-body row">
      <div class="col-md-8">
        <p><strong>CNPJ:</strong> <%= @organizacao.cnpj %></p>
        <p><strong>Endereço:</strong> <%= @organizacao.endereco %></p>
        <p><strong>CEP:</strong> <%= @organizacao.cep %></p>
        <p><strong>UF:</strong> <%= @organizacao.uf %></p>
        <p><strong>Telefone:</strong> <%= @organizacao.telefone %></p>
        <p><strong>Email:</strong> <%= @organizacao.email %></p>
        <p><strong>Serviços de Telecom:</strong> <%= @organizacao.servicos %></p>
      </div>
      <div class="col-md-4 text-end">
        <%= link_to "📄 Recibos", project_documents_path(@organizacao.projeto), class: "btn btn-outline-primary mt-3" %>
      </div>
    </div>
  </div>

  <!-- RESPONSÁVEL DA EMPRESA -->
  <div class="card shadow-sm rounded-3 mb-4">
    <div class="card-header bg-info text-white">
      <h5 class="mb-0">Responsável da Empresa</h5>
    </div>
    <div class="card-body row">
      <div class="col-md-4"><strong>Nome:</strong> <%= @responsavelEmpresa&.nome || '' %></div>
      <div class="col-md-4"><strong>Email:</strong> <%= @responsavelEmpresa&.email || '' %></div>
      <div class="col-md-4"><strong>Telefone:</strong> <%= @responsavelEmpresa&.telefone || '' %></div>
    </div>
  </div>

  <!-- RESPONSÁVEL PELO PREENCHIMENTO -->
  <div class="card shadow-sm rounded-3 mb-4">
    <div class="card-header bg-secondary text-white">
      <h5 class="mb-0">Responsável pelo Preenchimento</h5>
    </div>
    <div class="card-body row">
      <div class="col-md-4"><strong>Nome:</strong> <%= @responsavelPreenchimento.nome %></div>
      <div class="col-md-4"><strong>Email:</strong> <%= @responsavelPreenchimento.email %></div>
      <div class="col-md-4"><strong>Telefone:</strong> <%= @responsavelPreenchimento.telefone %></div>
    </div>
  </div>

  <!-- FILTROS DE COLETA -->
  <div class="card shadow-sm rounded-3 mb-4">
    <div class="card-header bg-dark text-white">
      <h5 class="mb-0">Coletas 2024</h5>
    </div>
    <div class="card-body">
      <div class="row text-center">
        <% ["Mensal", "Semestral", "Anual"].each do |tipo| %>
          <div class="col-md-4 mb-3">
            <div class="p-3 border rounded">
              <h6><%= tipo %></h6>
              <a href="/analista/cliente_analista?id_projeto=<%= @organizacao.idProject %>&titulo_coleta=Coleta<%= tipo %>"
                 class="btn <%= @tituloColeta == "Coleta#{tipo}" ? 'btn-success' : 'btn-outline-secondary' %> w-100">
                Filtrar Coleta
              </a>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- TABELA DE COLETAS -->
  <div class="card shadow-sm rounded-3">
    <div class="card-header bg-light">
      <h5 class="mb-0">Histórico de Coletas</h5>
    </div>
    <div class="card-body p-0">
      <table class="table table-striped table-hover m-0">
        <thead class="table-light">
          <tr>
            <th>Data</th>
            <th>Status</th>
            <th>Formulário</th>
            <th>Tipo</th>
            <th>Ação</th>
          </tr>
        </thead>
        <tbody>
          <% @coletas.each do |coleta| %>
            <tr>
              <td><%= coleta.textoData %></td>
              <td>
                <span class="badge rounded-pill <%= 
                  case coleta.status
                  when 'Coleta Atrasada' then 'bg-danger'
                  when 'Coleta Realizada' then 'bg-success'
                  else 'bg-secondary'
                  end
                %>"><%= coleta.status %></span>
              </td>
              <td><%= coleta.tituloColeta %></td>
              <td><%= coleta.tipoColeta %></td>
              <td>
                <% if coleta.dataRealizacao.nil? %>
                  <span class="text-muted">Aguardando dados da coleta...</span>
                <% elsif coleta.dataInformacaoEnvio.nil? %>
                  <a href="/coleta/gerarcsv?id_coleta=<%= coleta.id %>" class="btn btn-sm btn-outline-dark">Gerar CSV</a>
                <% else %>
                  <span class="text-muted">CSV enviado</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>

        
