<div class="container-md">
              <%= form_for @coleta, url: coleta_anual_atualizar_path do |f| %>
                   <%= f.hidden_field :ano, :value => @coleta.ano %>
                   <%= f.hidden_field :tituloColeta, :value => @coleta.tituloColeta %>
                   <%= f.hidden_field :tipoColeta, :value => @coleta.tipoColeta %>
                   <%= f.hidden_field :project_id, :value => @coleta.project_id %>

                    <div class="box-title"><%= @coleta.tipoColeta %></div>
                         
                      <div class="row mb-3">
                         <div class="col-md-6">
                              <p><%= f.label :cnpj, "CNPJ", class: "form-label" %></p>
                              <p><%= f.text_field :cnpj, class: "form-control", id: "cnpj", 
                                      placeholder: "Digite o CNPJ da Prestadora", required: true,
                                      maxlength: 14, oninput: "this.value = this.value.replace(/[^0-9]/g, '')" %></p>
                         </div>
                        

                         <div class="col-md-6">
                          <p><%= f.label :anoInformado, "Ano", class: "form-label" %></p>
                          <p><%= f.select :anoInformado, options_for_select([['escolher', 'Escolher...'],['2023', '2023'], ['2024', '2024'], ['2025', '2025']], @coleta.anoInformado), required: true %></p>
                         </div>
                       </div>

                      <div class="row mb-3">
                        <div class="col-md-6">
                          <p><%= f.label :idEstacaoOrigem, "Id Estação A", class: "form-label" %></p>
                          <p>
                            <%= f.text_field :idEstacaoOrigem, class: "form-control", id: "idEstacaoOrigem", 
                                placeholder: "Id da Estação A", required: true, 
                                pattern: "[0-9]*", title: "Este campo só pode conter números.", 
                                oninput: "this.value = this.value.replace(/[^0-9]/g, ''); showAlert()" %>
                          </p>
                          <small id="idEstacaoOrigemAlert" style="color: red; display: none;">Apenas números são permitidos.</small>
                        </div>

                          <script>
                            function showAlert() {
                              var input = document.getElementById("idEstacaoOrigem");
                              var alert = document.getElementById("idEstacaoOrigemAlert");
                              
                              if (input.value.match(/[^0-9]/)) {
                                alert.style.display = "inline";
                              } else {
                                alert.style.display = "none";
                              }
                            }
                          </script>      
                        
                       
                        

                        <div class="col-md-6">
                          <p><%= f.label :idEstacaoDestino, "Id Estação B", class: "form-label" %></p>
                          <p>
                            <%= f.text_field :idEstacaoDestino, class: "form-control", id: "idEstacaoDestino", 
                                placeholder: "Id da Estação B", required: true, 
                                pattern: "[0-9]*", title: "Este campo só pode conter números.", 
                                oninput: "this.value = this.value.replace(/[^0-9]/g, ''); showAlert()" %>
                          </p>
                          <small id="idEstacaoDestinoAlert" style="color: red; display: none;">Apenas números são permitidos.</small>
                        </div>

                          <script>
                            function showAlert() {
                              var input = document.getElementById("idEstacaoDestino");
                              var alert = document.getElementById("idEstacaoDestinoAlert");
                              
                              if (input.value.match(/[^0-9]/)) {
                                alert.style.display = "inline";
                              } else {
                                alert.style.display = "none";
                              }
                            }
                          </script> 


                      </div>

                     <div class="row mb-3">

                      <div class="col-md-6">
                          <p><%= f.label :idEnlace, "Id Estação B", class: "form-label" %></p>
                          <p>
                            <%= f.text_field :idEnlace, class: "form-control", id: "idEnlace", 
                                placeholder: "idEnlace", required: true, 
                                pattern: "[0-9]*", title: "Este campo só pode conter números.", 
                                oninput: "this.value = this.value.replace(/[^0-9]/g, ''); showAlert()" %>
                          </p>
                          <small id="idEnlaceAlert" style="color: red; display: none;">Apenas números são permitidos.</small>
                        </div>

                          <script>
                            function showAlert() {
                              var input = document.getElementById("idEnlace");
                              var alert = document.getElementById("idEnlaceAlert");
                              
                              if (input.value.match(/[^0-9]/)) {
                                alert.style.display = "inline";
                              } else {
                                alert.style.display = "none";
                              }
                            }
                          </script> 
                     
                       <div class="col-md-6">
                          <p><%= f.label :enlaceMeio, "Meio Transporte", class: "form-label" %></p>
                          <p><%= f.select :enlaceMeio, options_for_select([['escolher', 'Escolher...'],['cabo_metalico', 'cabo_metalico'], ['radio', 'radio'], ['fibra', 'fibra']], @coleta.enlaceMeio), required: true %></p>
                        </div>
                    </div>

                    <div class="row mb-3">
                      <div class="col-md-6">
                         <p><%= f.label :enlaceNominal, "Capacidade Nominal", class: "form-label" %></p>
                         <p><%= f.text_field :enlaceNominal, class: "form-control", id: "enlaceNominal", placeholder: "Enlace Nominal", required: true %></p>
                      </div>
                       <div class="col-md-6">
                          <p><%= f.label :enlaceSwap, "SN Swap", class: "form-label" %></p>
                          <p><%= f.select :enlaceSwap, options_for_select([['escolher', 'Escolher...'],['S', 'S'], ['N', 'N']], @coleta.enlaceSwap), required: true %></p>
                        </div>
                    </div>

                    <div class="row mb-3">
                      <div class="col-md-6">
                         <p><%= f.label :geometriaWkt, "Geometria WKT", class: "form-label" %></p>
                         <p><%= f.text_field :geometriaWkt, class: "form-control", geometriaWkt: "Geometria WKT", placeholder: "Geometria WKT", required: true %></p>
                      </div>
                       <div class="col-md-6">
                          <p><%= f.label :srid, "SRID", class: "form-label" %></p>
                          <p><%= f.text_field :srid, class: "form-control", id: "srid", placeholder: "SRID", required: true %></p>
                        </div>
                    </div>

                     <div class="row mb-3">
                       <div class="col-md-6">
                          <%= f.submit "Adicionar", class:" btn btn-primary" %>
                        </div>
                        <div class="col-md-6">
                          <%= link_to 'Concluir', cliente_cliente_path, class: 'btn btn-secondary btn-lg  text-white' %>

                        </div>
                       </div>
                       
               <% end %>

                    

  </div>
  

 <br/><br/>

<div class="container">
  <h4> Lista de Coletas</h4>
    <table class="table table-custom">
            <thead class="thead-light">
                <tr>
                    <th scope="col">CNPJ da Prestadora</th>
                    <th scope="col">Ano</th>
                    <th scope="col">Id da estação A</th>
                    <th scope="col">Id da estação B</th>
                    <th scope="col">Id Enlace</th>
                    <th scope="col">Tipo Meio Transporte</th>
                    <th scope="col">Capaxidade Nominal</th>
                    <th scope="col">SN Swap</th>
                    <th scope="col">Geometria WKT</th>
                    <th scope="col">SRID</th>
                    
                </tr>
            </thead>
            <tbody>
             <% for coleta in @coletas %>
                <tr> 
                     <td><%= coleta.cnpj %></td>
                     <td><%= coleta.ano %></td>
                     <td><%= coleta.idEstacaoOrigem %></td>
                     <td><%= coleta.idEstacaoDestino %></td>
                     <td><%= coleta.idEnlace %></td>
                     <td><%= coleta.enlaceMeio %></td>
                     <td><%= coleta.enlaceNominal %></td> 
                     <td><%= coleta.enlaceSwap %></td>
                     <td><%= coleta.geometriaWkt %></td>
                     <td><%= coleta.srid %></td>
                </tr>
            <% end %>
              
               
            </tbody>
        </table>
</div>
