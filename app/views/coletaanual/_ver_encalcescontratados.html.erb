<div class="container mt-4">
  <h4 class="mb-3">Lista de Coletas</h4>
  <div class="table-responsive">
    <table class="table table-striped table-bordered table-hover">
      <thead class="thead-light">
        <tr>
         <th scope="col">CNPJ</th>
         <th scope="col">Ano</th>
         <th scope="col">Id da estação de origem</th>
         <th scope="col">Id da estação de destino</th>
         <th scope="col">Id Enlace</th>
         <th scope="col">Enlace Meio</th>
         <th scope="col">CNPJ da Empresa contratada</th>
         <th scope="col" colspan="2" class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @coletas.each do |coleta| %>
          <tr>
            <td><%= coleta.cnpj %></td>
            <td><%= coleta.ano %></td>
            <td><%= coleta.idEstacaoOrigem %></td>
            <td><%= coleta.idEstacaoDestino %></td>
            <td><%= coleta.idEnlace %></td>
            <td><%= coleta.enlaceMeio %></td>
            <td><%= coleta.cnpjContratada %></td>
            <td class="text-center">
              <%= form_for coleta, url: coleta_anual_editar_path do |f| %>
                <%= f.hidden_field :id_coleta, :value => coleta.id %>
                <%= button_tag 'Editar', type: 'submit', class: 'btn btn-danger text-white'%>
              <% end %>
            </td>
            <td class="text-center">
              <%= form_for coleta, url: coleta_anual_excluir_path do |f| %>
                <%= f.hidden_field :id_coleta, :value => coleta.id %>
                <%= button_tag 'Excluir', type: 'submit', class: 'btn btn-danger text-white', data: { confirm: 'Tem certeza que deseja excluir?' } %>
                
              <% end %>


            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>









