<div class="container-md">
              <%= form_for @coleta, url: coleta_editar_salvar_path do |f| %>
                   <%= f.hidden_field :id, :value => @coleta.id %>
                   <%= f.hidden_field :ano, :value => @coleta.ano %>
                   <%= f.hidden_field :tituloColeta, :value => @coleta.tituloColeta %>
                   <%= f.hidden_field :tipoColeta, :value => @coleta.tipoColeta %>
                   <%= f.hidden_field :project_id, :value => @coleta.project_id %>

                    <div class="box-title"><%= @coleta.tipoColeta %></div>
                         
                      <div class="row mb-3">
                         <div class="col-md-6">
                              <p><%= f.label :cnpj, "CNPJ", class: "form-label" %></p>
                              <p><%= f.text_field :cnpj, class: "form-control", id: "cnpj", 
                                      placeholder: "Digite o CNPJ da Prestadora", required: true,
                                      maxlength: 14, oninput: "this.value = this.value.replace(/[^0-9]/g, '')" %></p>
                         </div>
                        

                         <div class="col-md-6">
                          <p><%= f.label :anoInformado, "Ano", class: "form-label" %></p>
                          <p><%= f.select :anoInformado, options_for_select([['2023', '2023'], ['2024', '2024'], ['2025', '2025']]), required: true %></p>
                         </div>
                       </div>

                      <div class="row mb-3">
                        <div class="col-md-6">
                          <p><%= f.label :idEstacaoOrigem, "Id da estação de origem", class: "form-label" %></p>
                          <p><%= f.text_field :idEstacaoOrigem, class: "form-control", id: "idEstacaoOrigem", placeholder: "Id da Estação de Origem", required: true %></p>
                        </div>
                        <div class="col-md-6">
                          <p><%= f.label :idEstacaoDestino, "Id da estação de destino", class: "form-label" %></p>
                          <p><%= f.text_field :idEstacaoDestino, class: "form-control", id: "idEstacaoDestino", placeholder: "Id da Estação de destino", required: true %></p>
                        </div>
                      </div>

                     <div class="row mb-3">
                      <div class="col-md-6">
                         <p><%= f.label :idEnlace, "Id Enlace", class: "form-label" %></p>
                         <p><%= f.text_field :idEnlace, class: "form-control", id: "idEnlace", placeholder: "Id Enlace", required: true %></p>
                      </div>
                       <div class="col-md-6">
                          <p><%= f.label :enlaceMeio, "Enlace Meio", class: "form-label" %></p>
                          <p><%= f.select :enlaceMeio, options_for_select([['escolher', 'Escolher...'],['cabo_metalico', 'cabo_metálico'], ['radio', 'Rádio'], ['fibra', 'Fibra']]), required: true %></p>
                        </div>
                    </div>

                    <div class="row mb-3">
                      <div class="col-md-6">
                         <p><%= f.label :enlaceNominal, "Enlace Nominal", class: "form-label" %></p>
                         <p><%= f.text_field :enlaceNominal, class: "form-control", id: "enlaceNominal", placeholder: "Enlace Nominal", required: true %></p>
                      </div>
                       <div class="col-md-6">
                          <p><%= f.label :enlaceSwap, "Enlace Swap", class: "form-label" %></p>
                          <p><%= f.select :enlaceSwap, options_for_select([['escolher', 'Escolher...'],['s', 'S(SIM)'], ['n', 'N(NÃO)']]), required: true %></p>
                        </div>
                    </div>

                    <div class="row mb-3">
                      <div class="col-md-6">
                         <p><%= f.label :geometriaWkt, "Geometria WKT", class: "form-label" %></p>
                         <p><%= f.text_field :geometriaWkt, class: "form-control", geometriaWkt: "Geometria WKT", placeholder: "Geometria WKT", required: true %></p>
                      </div>
                       <div class="col-md-6">
                          <p><%= f.label :srid, "SRID", class: "form-label" %></p>
                          <p><%= f.text_field :srid, class: "form-control", id: "srid", placeholder: "SRID", required: true %></p>
                        </div>
                    </div>

                     <div class="row mb-3">
                       <div class="col-md-6">
                          <%= f.submit "Salvar", class:" btn btn-primary" %>
                        </div>
                        
                       </div>
                       
               <% end %>

                    

  </div>
  

 <br/><br/>

