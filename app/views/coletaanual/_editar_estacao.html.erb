<div class="container-md">
             <%= form_for @coleta, url: coleta_anual_salvar_path, :html => {:id => "formColeta"} do |f| %>
                   <%= f.hidden_field :id, :value => @coleta.id %>
                   <%= f.hidden_field :uf, :value => @coleta.uf %>
                   <%= f.hidden_field :cidade, :value => @coleta.cidade %>
                   <%= f.hidden_field :codigoIBGE, :value => @coleta.codigoIBGE %>
                   <%= f.hidden_field :ano, :value => @coleta.ano %>
                   <%= f.hidden_field :tituloColeta, :value => @coleta.tituloColeta %>
                   <%= f.hidden_field :tipoColeta, :value => @coleta.tipoColeta %>
                   <%= f.hidden_field :project_id, :value => @coleta.project_id %>

                    <div class="box-title"><%= @coleta.tipoColeta %></div>
                       <div class="box-description">Coleta de dados de acessos:
                         
                       <div class="row mb-3">
                         <div class="col-md-6">
                              <p><%= f.label :cnpj, "CNPJ", class: "form-label" %></p>
                              <p><%= f.text_field :cnpj, class: "form-control", id: "cnpj", 
                                      placeholder: "Digite o CNPJ da Prestadora", required: true,
                                      maxlength: 14, oninput: "this.value = this.value.replace(/[^0-9]/g, '')" %></p>
                         </div>
                        

                         <div class="col-md-6">
                          <p><%= f.label :anoInformado, "Ano", class: "form-label" %></p>
                          <p><%= f.select :anoInformado, options_for_select([['2023', '2023'], ['2024', '2024'], ['2025', '2025'], ['2026', '2026'], ['2027', '2027'], ['2028', '2028'], ['2029', '2029'], ['2030', '2030']], @coleta.anoInformado), required: true %></p>
                         </div>
                       </div>

                      <div class="row mb-3">
                       <div class="col-md-6">
                          <p><%= f.label :idEstacao, "Id Estação", class: "form-label" %></p>
                          <p><%= f.text_field :idEstacao, class: "form-control", id: "idEstacao", 
                                  placeholder: "Id da Estação", required: true, 
                                  pattern="[0-9]*" title="Este campo só pode conter números.", 
                                  oninput="this.value = this.value.replace(/[^0-9]/g, ''); showAlert(this)" %></p>
                                 <small id="idEstacaoAlert" style="color: red; display: none;">Apenas números são permitidos.</small>

                        <script>
                          function showAlert(input) {
                            const alert = document.getElementById("idEstacaoAlert");
                            if (input.value.match(/[^0-9]/)) {
                              alert.style.display = "inline";
                            } else {
                              alert.style.display = "none";
                            }
                          }
                        </script>


                        </div>

                        
                        <div class="col-md-6">
                          <p><%= f.label :nEstacao, "Número da Estação", class: "form-label" %></p>
                          <p><%= f.text_field :nEstacao, class: "form-control", id: "nEstacao", placeholder: "Número da Estação", required: true %></p>
                        </div>
                      </div>

                     <div class="row mb-3">
                      <div class="col-md-6">
                         <p><%= f.label :latitude, "Latitude", class: "form-label" %></p>
                         <p><%= f.text_field :latitude, class: "form-control", latitude: "Latitude", placeholder: "Latitude", required: true %></p>
                      </div>
                       <div class="col-md-6">
                          <p><%= f.label :longitude, "Longitude", class: "form-label" %></p>
                          <p><%= f.text_field :longitude, class: "form-control", longitude: "Longitude", placeholder: "Longitude", required: true %></p>
                        </div>
                       </div>

                     <div class="row mb-3">
                      <div class="col-md-6">
                         <p><%= f.label :codigoIBGE, "Código IBGE", class: "form-label" %></p>
                         <p><%= f.text_field :codigoIBGE, class: "form-control", id: "codigoIBGE", placeholder: "Código IBGE", disabled: true, required: true %></p>
                      </div>
                       
                      <div class="col-md-6">
                        <p><%= f.label :rua, "Rua", class: "form-label" %></p>
                        <p><%= f.text_field :rua, class: "form-control", rua: "Rua", placeholder: "Rua", required: true %></p>
                      </div>
                    </div>

                     <div class="row mb-3">
                        <div class="col-md-6">
                          <p><%= f.label :numeroEndereco, "Número", class: "form-label" %></p>
                          <p><%= f.text_field :numeroEndereco, class: "form-control", numero: "Número", placeholder: "Número", required: true %></p>
                        </div>
                         <div class="col-md-6">
                          <p><%= f.label :cidade, "Cidade", class: "form-label" %></p>
                          <p><%= f.text_field :cidade, class: "form-control", id: "cidade", placeholder: "Cidade", disabled: true, required: true %></p>
                        </div>
                     </div>
                   <div class="row mb-3">
                     <div class="col-md-6">
                         <p><%= f.label :cep, "Cep", class: "form-label" %></p>
                         <p><%= f.text_field :cep, class: "form-control", id: "cep", placeholder: "Cep", required: true %></p>
                      </div>
                      <div class="col-md-6">
                         <p><%= f.label :abertura, "Abertura", class: "form-label" %></p>
                         <p><%= f.select :abertura, options_for_select([['S', 'S'], ['N', 'N']], @coleta.abertura), required: true %></p>
                      </div>
                    </div>
                                              
                    <div class="row mb-3">
                      <div class="col-md-6">
                         <p><%= f.label :tpEstacao, "Tipo de Estação", class: "form-label" %></p>
                         <p><%= f.select :tpEstacao, options_for_select([['propria', 'propria'], ['terceiro', 'terceiro'], ['nuvem', 'nuvem']], @coleta.tpEstacao), required: true %></p>
                      </div>
                      <div class="col-md-6">
                        <p><%= f.label :largCanalUplink, "SN Enlace Próprio", class: "form-label" %></p>
                          <p><%= f.select :largCanalUplink, options_for_select([['S', 'S'], ['N', 'N']], @coleta.largCanalUplink), required: true %></p>
                      </div>
                      
                    </div>

                    <div class="row mb-3">

                       <div class="col-md-6">
                         <p><%= f.label :capCanalDownlink, "SN Enlace Contratado", class: "form-label" %></p>
                         <p><%= f.select :capCanalDownlink, options_for_select([['S', 'S'], ['N', 'N']], @coleta.capCanalDownlink), required: true %></p>
                      </div>
                        
                      <div class="col-md-6">
                        <p><%= f.label :capCanalUplink, "SN Enlace Satélite", class: "form-label" %></p>
                        <p><%= f.select :capCanalUplink, options_for_select([['S', 'S'], ['N', 'N']], @coleta.capCanalUplink), required: true %></p>
                         
                      </div>
                       
                    </div>
                    

                    

                    <div class="row mb-3">
                       <div class="col-md-6">
                          <%= f.submit "Salvar", class: 'btn btn-secondary text-white' %>
                        </div>
                        <div class="col-md-6">
                          <%= link_to 'Concluir', cliente_cliente_path, class: 'btn btn-secondary btn-lg  text-white' %>

                        </div>
                      </div>


                          



               <% end %>

  </div>
</div>

 <br/><br/>



