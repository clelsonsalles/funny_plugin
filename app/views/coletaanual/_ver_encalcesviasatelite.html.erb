<div class="container mt-4">
  <h4 class="mb-3">Lista de Coletas</h4>
  <div class="table-responsive">
    <table class="table table-striped table-bordered table-hover">
      <thead class="thead-light">
        <tr>
         <th scope="col">CNPJ da Prestadora</th>
         <th scope="col">Ano</th>
         <th scope="col">Id da estação de origem</th>
         <th scope="col">Id Satélite</th>
         <th scope="col">Código do Satélite</th>
         <th scope="col">Frequência do Satélite uplink</th>
         <th scope="col">Frequência do Satélite Downlink</th>
         <th scope="col">Largura do canal Uplink</th>
         <th scope="col">Capacidade do Canal Uplink</th>
         <th scope="col">Largura do canal downlink</th>
         <th scope="col">Capacidade do Canal Downlink</th>
         <th scope="col" colspan="2" class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @coletas.each do |coleta| %>
          <tr>
            <td><%= coleta.cnpj %></td>
            <td><%= coleta.ano %></td>
            <td><%= coleta.idEstacaoOrigem %></td>
            <td><%= coleta.idSatelite %></td>
            <td><%= coleta.codigoSatelite %></td>
            <td><%= coleta.freqUplink %></td>
            <td><%= coleta.freqDownlink %></td> 
            <td><%= coleta.largCanalUplink %></td>
            <td><%= coleta.capCanalUplink %></td>
            <td><%= coleta.largCanalDownlink %></td>
            <td><%= coleta.capCanalDownlink %></td>
            <td class="text-center">
              <%= link_to 'Editar', cliente_cliente_path, class: 'btn btn-sm btn-success text-white' %>
            </td>
            <td class="text-center">
              <%= link_to 'Excluir', cliente_cliente_path, class: 'btn btn-sm btn-danger text-white', data: { confirm: 'Tem certeza que deseja excluir?' } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>









