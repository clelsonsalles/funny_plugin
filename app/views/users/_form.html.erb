<%= error_messages_for 'user' %>

<div id="user_form">
  <!--[form:user]-->
  <div class="splitcontent">
    <div class="splitcontentleft">
      <fieldset class="box tabular">
        <legend><%= l(:label_information_plural) %></legend>
        <div class="row mb-3">
          <div class="col-md-6">
            <%= f.label :login %>
            <%= f.text_field :login, required: true, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= f.label :firstname %>
            <%= f.text_field :firstname, required: true, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <%= f.label :lastname %>
            <%= f.text_field :lastname, required: true, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= f.label :mail %>
            <%= f.text_field :mail, required: true, class: "form-control" %>
          </div>
        </div>

        <% unless @user.force_default_language? %>
          <div class="row mb-3">
            <div class="col-md-6">
              <%= f.label :language %>
              <%= f.select :language, lang_options_for_select, {}, class: "form-select" %>
            </div>
          </div>
        <% end %>

        <% @user.custom_field_values.each do |value| %>
          <div class="row mb-3">
            <div class="col-md-6">
              <%= custom_field_tag_with_label :user, value %>
            </div>
          </div>
        <% end %>

        <div class="row mb-3">
          <div class="col-md-6">
            <div class="form-check">
              <%= f.check_box :admin, { disabled: (@user == User.current), class: "form-check-input", id: "user_admin" } %>
              <%= f.label :admin, class: "form-check-label", for: "user_admin" %>
            </div>
          </div>
        </div>

        <%= call_hook(:view_users_form, user: @user, form: f) %>
      </fieldset>

      <fieldset class="box tabular">
        <legend><%= l(:label_authentication) %></legend>
        <% unless @auth_sources.empty? %>
          <div class="row mb-3">
            <div class="col-md-6">
              <%= f.label :auth_source_id %>
              <%= f.select :auth_source_id,
                    [[l(:label_internal), ""]] + @auth_sources.collect { |a| [a.name, a.id] },
                    {},
                    class: "form-select",
                    onchange: "if (this.value=='') {$('#password_fields').show();} else {$('#password_fields').hide();}" %>
            </div>
          </div>
        <% end %>

        <div id="password_fields" style="<%= 'display:none;' if @user.auth_source %>">
          <div class="row mb-3">
            <div class="col-md-6">
              <%= f.label :password %>
              <%= f.password_field :password, required: @user.new_record?, class: "form-control" %>
              <em class="info"><%= l(:text_caracters_minimum, count: Setting.password_min_length) %></em>
              <% if Setting.password_required_char_classes.any? %>
                <em class="info">
                  <%= l(:text_characters_must_contain, character_classes: Setting.password_required_char_classes.collect { |c| l("label_password_char_class_#{c}") }.join(", ")) %>
                </em>
              <% end %>
            </div>
            <div class="col-md-6">
              <%= f.label :password_confirmation %>
              <%= f.password_field :password_confirmation, required: @user.new_record?, class: "form-control" %>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <div class="form-check">
                <%= f.check_box :generate_password, class: "form-check-input", id: "user_generate_password" %>
                <%= f.label :generate_password, class: "form-check-label", for: "user_generate_password" %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-check">
                <%= f.check_box :must_change_passwd, class: "form-check-input", id: "user_must_change_passwd" %>
                <%= f.label :must_change_passwd, class: "form-check-label", for: "user_must_change_passwd" %>
              </div>
            </div>
          </div>
        </div>

        <% if Setting.twofa? && !@user.new_record? -%>
          <div class="row mb-3">
            <div class="col-md-12">
              <label><%= l :setting_twofa -%></label>
              <% if @user.twofa_active? %>
                <p><%= l 'twofa_currently_active', twofa_scheme_name: l("twofa__#{@user.twofa_scheme}__name") %></p>
                <% if @user == User.current %>
                  <%= link_to l('button_disable'), { controller: 'twofa', action: 'deactivate_init', scheme: @user.twofa_scheme }, method: :post %>
                <% else %>
                  <%= link_to l('button_disable'), { controller: 'twofa', action: 'admin_deactivate', user_id: @user }, method: :post %>
                <% end %>
              <% else %>
                <%= l 'twofa_not_active' %>
              <% end %>
            </div>
          </div>
        <% end -%>
      </fieldset>
    </div>
  </div>
</div>

<div style="clear:left;"></div>
<!--[eoform:user]-->

<%= javascript_tag do %>
  $(document).ready(function(){
    $('#user_generate_password').change(function(){
      var passwd = $('#user_password, #user_password_confirmation');
      if ($(this).is(':checked')){
        passwd.val('').attr('disabled', true);
      } else {
        passwd.removeAttr('disabled');
      }
    }).trigger('change');
  });
<% end %>
