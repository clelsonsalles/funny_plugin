<%= error_messages_for 'user' %>

<div id="user_form" class="container mt-4">
  <%= labelled_form_for @user, url: register_path do |f| %>
    <div class="row">
      <div class="col-md-6 mb-3">
        <%= f.label :login %>
        <%= f.text_field :login, class: "form-control", required: true %>
      </div>
      <div class="col-md-6 mb-3">
        <%= f.label :firstname %>
        <%= f.text_field :firstname, class: "form-control", required: true %>
      </div>
      <div class="col-md-6 mb-3">
        <%= f.label :lastname %>
        <%= f.text_field :lastname, class: "form-control", required: true %>
      </div>
      <div class="col-md-6 mb-3">
        <%= f.label :mail %>
        <%= f.text_field :mail, class: "form-control", required: true %>
      </div>
      <% unless @user.force_default_language? %>
        <div class="col-md-6 mb-3">
          <%= f.label :language %>
          <%= f.select :language, lang_options_for_select, {}, class: "form-select" %>
        </div>
      <% end %>

      <% @user.custom_field_values.each do |value| %>
        <div class="col-md-6 mb-3">
          <%= custom_field_tag_with_label :user, value %>
        </div>
      <% end %>

      <div class="col-12">
        <fieldset class="border p-3 mb-4">
          <legend class="w-auto px-2">Autenticação</legend>
          <% unless @auth_sources.empty? %>
            <div class="mb-3">
              <%= f.label :auth_source_id, "Fonte de autenticação" %>
              <%= f.select :auth_source_id, [[l(:label_internal), ""]] + @auth_sources.map { |a| [a.name, a.id] }, {}, onchange: "if (this.value=='') {$('#password_fields').show();} else {$('#password_fields').hide();}", class: "form-select" %>
            </div>
          <% end %>

          <div id="password_fields" style="<%= 'display:none;' if @user.auth_source %>">
            <div class="mb-3">
              <%= f.label :password %>
              <%= f.password_field :password, class: "form-control", required: @user.new_record? %>
              <small class="form-text text-muted"><%= l(:text_caracters_minimum, count: Setting.password_min_length) %></small>
              <% if Setting.password_required_char_classes.any? %>
                <small class="form-text text-muted"><%= l(:text_characters_must_contain, character_classes: Setting.password_required_char_classes.collect { |c| l("label_password_char_class_\#{c}") }.join(", ")) %></small>
              <% end %>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation %>
              <%= f.password_field :password_confirmation, class: "form-control", required: @user.new_record? %>
            </div>

            <div class="form-check mb-3 shadow-sm p-2 rounded bg-light">
              <%= f.check_box :generate_password, {}, '1', '0' %>
              <%= f.label :generate_password, "Gerar senha", class: "form-check-label" %>
            </div>

            <div class="form-check mb-3 shadow-sm p-2 rounded bg-light">
              <%= f.check_box :must_change_passwd, {}, '1', '0' %>
              <%= f.label :must_change_passwd, "É necessário alterar sua senha na próxima vez que tentar acessar sua conta", class: "form-check-label" %>
            </div>
          </div>

          <% if Setting.twofa? && !@user.new_record? %>
            <div class="mb-3">
              <label><%= l :setting_twofa %></label>
              <% if @user.twofa_active? %>
                <p><%= l 'twofa_currently_active', twofa_scheme_name: l("twofa__\#{@user.twofa_scheme}__name") %></p>
                <% if @user == User.current %>
                  <%= link_to l('button_disable'), { controller: 'twofa', action: 'deactivate_init', scheme: @user.twofa_scheme }, method: :post, class: "btn btn-warning" %>
                <% else %>
                  <%= link_to l('button_disable'), { controller: 'twofa', action: 'admin_deactivate', user_id: @user }, method: :post, class: "btn btn-warning" %>
                <% end %>
              <% else %>
                <p><%= l 'twofa_not_active' %></p>
              <% end %>
            </div>
          <% end %>

          <div class="form-check mb-3">
            <%= f.check_box :admin, { disabled: (@user == User.current) }, '1', '0' %>
            <%= f.label :admin, class: "form-check-label" %>
          </div>
        </fieldset>
      </div>
    </div>

    <div class="d-flex justify-content-center gap-3">
      <%= submit_tag l(:button_create), name: 'continue', class: 'btn btn-primary' %>
      <%= submit_tag l(:button_create_and_continue), name: 'add_continue', class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>

<%= javascript_tag do %>
  $(document).ready(function(){
    $('#user_generate_password').change(function(){
      var passwd = $('#user_password, #user_password_confirmation');
      if ($(this).is(':checked')){
        passwd.val('').attr('disabled', true);
      }else{
        passwd.removeAttr('disabled');
      }
    }).trigger('change');
  });
<% end %>
