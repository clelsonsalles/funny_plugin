<%= error_messages_for 'user' %>

<div id="user_form">
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <%= l(:label_information_plural) %>
    </div>
    <div class="card-body">
      <div class="row mb-3">
        <div class="col-md-6 mb-3">
          <%= f.label :login, class: "form-label" %>
          <%= f.text_field :login, required: true, size: 25, class: "form-control" %>
        </div>
        <div class="col-md-6 mb-3">
          <%= f.label :firstname, class: "form-label" %>
          <%= f.text_field :firstname, required: true, class: "form-control" %>
        </div>
        <div class="col-md-6 mb-3">
          <%= f.label :lastname, class: "form-label" %>
          <%= f.text_field :lastname, required: true, class: "form-control" %>
        </div>
        <div class="col-md-6 mb-3">
          <%= f.label :mail, class: "form-label" %>
          <%= f.text_field :mail, required: true, class: "form-control" %>
        </div>

        <% unless @user.force_default_language? %>
          <div class="col-md-6 mb-3">
            <%= f.label :language, class: "form-label" %>
            <%= f.select :language, lang_options_for_select, {}, class: "form-select" %>
          </div>
        <% end %>

        <% @user.custom_field_values.each do |value| %>
          <div class="col-md-6 mb-3">
            <%= custom_field_tag_with_label :user, value %>
          </div>
        <% end %>

        <div class="col-12 mb-3">
          <div class="form-check">
            <%= f.check_box :admin, disabled: (@user == User.current), class: "form-check-input" %>
            <%= f.label :admin, class: "form-check-label" %>
          </div>
        </div>
        <%= call_hook(:view_users_form, user: @user, form: f) %>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-secondary text-white">
      <%= l(:label_authentication) %>
    </div>
    <div class="card-body">
      <% unless @auth_sources.empty? %>
        <div class="mb-3">
          <%= f.label :auth_source_id, class: "form-label" %>
          <%= f.select :auth_source_id, 
                ([[l(:label_internal), ""]] + @auth_sources.collect { |a| [a.name, a.id] }), 
                {}, 
                onchange: "if (this.value=='') {$('#password_fields').show();} else {$('#password_fields').hide();}", 
                class: "form-select" %>
        </div>
      <% end %>

      <div id="password_fields" style="<%= 'display:none;' if @user.auth_source %>">
        <div class="row">
          <div class="col-md-6 mb-3">
            <%= f.label :password, class: "form-label" %>
            <%= f.password_field :password, required: @user.new_record?, size: 25, class: "form-control" %>
            <small class="form-text text-muted">
              <%= l(:text_caracters_minimum, count: Setting.password_min_length) %>
              <% if Setting.password_required_char_classes.any? %>
                <br/>
                <%= l(:text_characters_must_contain, character_classes: Setting.password_required_char_classes.collect { |c| l("label_password_char_class_#{c}") }.join(", ")) %>
              <% end %>
            </small>
          </div>

          <div class="col-md-6 mb-3">
            <%= f.label :password_confirmation, class: "form-label" %>
            <%= f.password_field :password_confirmation, required: @user.new_record?, size: 25, class: "form-control" %>
          </div>
        </div>

        <div class="mb-3">
          <div class="form-check">
            <%= f.check_box :generate_password, {}, '1', '0', class: "form-check-input", id: "user_generate_password" %>
            <%= f.label :generate_password, class: "form-check-label", for: "user_generate_password" %>
          </div>
        </div>

        <div class="mb-3">
          <div class="form-check">
            <%= f.check_box :must_change_passwd, {}, '1', '0', class: "form-check-input" %>
            <%= f.label :must_change_passwd, class: "form-check-label" %>
          </div>
        </div>
      </div>

      <% if Setting.twofa? && !@user.new_record? -%>
        <div class="mt-3">
          <label class="form-label"><%= l(:setting_twofa) %></label><br/>
          <% if @user.twofa_active? %>
            <%= l('twofa_currently_active', twofa_scheme_name: l("twofa__#{@user.twofa_scheme}__name")) %><br/>
            <% if @user == User.current %>
              <%= link_to l('button_disable'), { controller: 'twofa', action: 'deactivate_init', scheme: @user.twofa_scheme }, method: :post, class: "btn btn-danger btn-sm mt-2" %>
            <% else %>
              <%= link_to l('button_disable'), { controller: 'twofa', action: 'admin_deactivate', user_id: @user }, method: :post, class: "btn btn-danger btn-sm mt-2" %>
            <% end %>
          <% else %>
            <%= l('twofa_not_active') %>
          <% end %>
        </div>
      <% end -%>
    </div>
  </div>
</div>

<%= javascript_tag do %>
$(document).ready(function(){
  $('#user_generate_password').change(function(){
    var passwd = $('#user_password, #user_password_confirmation');
    if ($(this).is(':checked')){
      passwd.val('').attr('disabled', true);
    }else{
      passwd.removeAttr('disabled');
    }
  }).trigger('change');
});
<% end %>

