
<div class="container mt-4">
  <h4 class="mb-3">Lista de Coletas</h4>
  <div class="table-responsive">
    <table class="table table-striped table-bordered table-hover">
      <thead class="thead-light">
        <tr>
          <th scope="col">CNPJ</th>
          <th scope="col">Mês</th>
          <th scope="col">Ano</th>
          <th scope="col">UF</th>
          <th scope="col">Cidade</th>
          <th scope="col">Tipo de Cliente</th>
          <th scope="col">Tipo de Atendimento</th>
          <th scope="col">Tipo Meio</th>
          <th scope="col">Tipo de Tecnologia</th>
          <th scope="col">Tipo de Produto</th>
          <th scope="col">Velocidade</th>
          <th scope="col">Quantidade</th>
          <th scope="col">Código IBGE</th>
          <th scope="col" colspan="2" class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @coletas.each do |coleta| %>
          <tr>
            <td><%= coleta.cnpj %></td>
            <td><%= coleta.mesInformado %></td>
            <td><%= coleta.anoInformado %></td>
            <td><%= coleta.uf %></td>
            <td><%= coleta.cidade %></td>
            <td><%= coleta.tipoCliente %></td>
            <td><%= coleta.tipoAtendimento %></td>
            <td><%= coleta.tipoMeio %></td>
            <td><%= coleta.tipoTecnologia %></td>
            <td><%= coleta.tipoProduto %></td>
            <td><%= coleta.velocidade %></td>
            <td><%= coleta.quantidadeAcesso %></td>
            <td><%= coleta.codigoIBGE %></td>
            <td class="text-center">
              <%= link_to 'Editar', cliente_cliente_path, class: 'btn btn-sm btn-success' %>
            </td>
            <td class="text-center">
              <%= link_to 'Excluir', cliente_cliente_path, class: 'btn btn-sm btn-outline-danger', data: { confirm: 'Tem certeza que deseja excluir?' } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
