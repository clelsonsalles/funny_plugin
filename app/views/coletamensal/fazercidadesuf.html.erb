<div class="container mt-4">
  <%= form_for @coleta, url: coleta_mensal_fazer_path, html: { id: "formColeta", class: "needs-validation", novalidate: true } do |f| %>
    <%= f.hidden_field :id, value: @coleta.id %>
    <%= f.hidden_field :uf, value: @coleta.uf %>
    <%= f.hidden_field :mes, value: @coleta.mes %>
    <%= f.hidden_field :ano, value: @coleta.ano %>
    <%= f.hidden_field :tituloColeta, value: @coleta.tituloColeta %>
    <%= f.hidden_field :tipoColeta, value: @coleta.tipoColeta %>
    <%= f.hidden_field :project_id, value: @coleta.project_id %>

    <div class="box-title mb-4"><h4><%= @coleta.tipoColeta %></h4></div>

    <div class="card shadow-sm p-3 mb-4" style="border: 1px solid #dcdcdc;">
      <div class="card-body">
        <div class="row mb-3">
          <div class="col-md-6">
            <%= f.label :uf, "UF selecionada", class: "form-label" %>
            <%= f.text_field :uf, class: "form-control", id: "uf", disabled: true %>
          </div>

          <div class="col-md-6">
            <% listaSelectMunicipio = [["Selecione", ""]] + @municipios.map { |m| [m.nome, m.nome] } %>
            <%= f.label :cidade, "Cidade", class: "form-label" %>
            <%= f.select :cidade, options_for_select(listaSelectMunicipio), {}, class: "form-select", id: "coleta_cidade", required: true %>
            <div class="invalid-feedback">
              Por favor, selecione uma cidade.
            </div>
          </div>
        </div>

        <div class="row mb-4">
          <div class="col-md-6">
            <%= f.label :codigoIBGE, "Código IBGE", class: "form-label" %>
            <%= f.text_field :codigoIBGE, class: "form-control", id: "codigoIBGE", placeholder: "Preenchido automaticamente", disabled: true, required: true %>
            <div class="invalid-feedback">
              Código IBGE não pode estar em branco.
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col text-end">
            <%= f.submit 'Concluir', class: 'btn btn-success btn-lg' %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('formColeta');
    const cidadeSelect = document.getElementById('coleta_cidade');
    const codigoIBGE = document.getElementById('codigoIBGE');

    // Submete automaticamente ao mudar cidade (como já fazia)
    cidadeSelect.addEventListener('change', () => {
      form.submit();
    });

    // Validação visual do Bootstrap
    form.addEventListener('submit', function (event) {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    }, false);
  });
</script>









              
