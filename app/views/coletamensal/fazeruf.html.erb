<div class="container mt-4">
  <%= form_for @coleta, url: coleta_mensal_fazer_path, html: { id: "formColeta", class: "needs-validation", novalidate: true } do |f| %>
    <%= f.hidden_field :id, value: @coleta.id %>
    <%= f.hidden_field :mes, value: @coleta.mes %>
    <%= f.hidden_field :ano, value: @coleta.ano %>
    <%= f.hidden_field :tituloColeta, value: @coleta.tituloColeta %>
    <%= f.hidden_field :tipoColeta, value: @coleta.tipoColeta %>
    <%= f.hidden_field :project_id, value: @coleta.project_id %>

    <h4 class="mb-4"><%= @coleta.tipoColeta %></h4>

    <!-- UF -->
    <div class="row mb-3">
      <div class="col-md-6">
        <%= f.label :uf, "UF", class: "form-label" %>
        <%= f.select :uf, options_for_select(["Selecione", "AC", "AL", "AM", "AP", "BA", "CE", "DF", "ES", "GO", "MA", "MG", "MS", "MT", "PA", "PB", "PE", "PI", "PR", "RJ", "RN", "RO", "RR", "RS", "SC", "SE", "SP", "TO"]), {}, class: "form-select", id: "uf", required: true %>
        <div class="invalid-feedback">Selecione uma UF.</div>
      </div>
    </div>

    <!-- Cidade -->
    <div class="row mb-3">
      <div class="col-md-6">
        <%= f.label :cidade, "Cidade", class: "form-label" %>
        <%= f.select :cidade, [], {}, class: "form-select", id: "cidade", required: true %>
        <div class="invalid-feedback">Selecione uma cidade.</div>
      </div>
    </div>

    <!-- Código IBGE -->
    <div class="row mb-4">
      <div class="col-md-6">
        <%= f.label :codigoIBGE, "Código IBGE", class: "form-label" %>
        <%= f.text_field :codigoIBGE, class: "form-control", id: "codigoIBGE", placeholder: "Código IBGE da cidade", readonly: true, required: true %>
        <div class="invalid-feedback">Código IBGE é obrigatório.</div>
      </div>
    </div>

    <!-- Botão -->
    <div class="row">
      <div class="col text-end">
        <%= f.submit 'Concluir', class: 'btn btn-primary btn-lg' %>
      </div>
    </div>
  <% end %>
</div>

<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', () => {
    const ufSelect = document.getElementById('uf');
    const cidadeSelect = document.getElementById('cidade');
    const codigoIBGEInput = document.getElementById('codigoIBGE');
    const form = document.getElementById('formColeta');

    ufSelect.addEventListener('change', () => {
      const uf = ufSelect.value;
      cidadeSelect.innerHTML = '<option value="">Carregando cidades...</option>';
      codigoIBGEInput.value = '';

      if (uf && uf !== 'Selecione') {
        fetch(`https://servicodados.ibge.gov.br/api/v1/localidades/estados/${uf}/municipios`)
          .then(response => response.json())
          .then(data => {
            cidadeSelect.innerHTML = '<option value="">Selecione</option>';
            data.forEach(mun => {
              const option = document.createElement('option');
              option.value = mun.nome;
              option.dataset.codigo = mun.id;
              cidadeSelect.appendChild(option);
            });
          });
      } else {
        cidadeSelect.innerHTML = '<option value="">Selecione uma UF primeiro</option>';
      }
    });

    cidadeSelect.addEventListener('change', () => {
      const selectedOption = cidadeSelect.options[cidadeSelect.selectedIndex];
      const codigoIBGE = selectedOption.dataset.codigo || '';
      codigoIBGEInput.value = codigoIBGE;
    });

    // Validação visual do Bootstrap
    form.addEventListener('submit', function (event) {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    }, false);
  });
</script>
