<div class="container-md">
  <div class="card shadow-sm border border-2 rounded-3">
    <div class="card-header bg-light">
      <h5 class="mb-0 text-primary fw-bold"><%= @coleta.tipoColeta %> - Coleta de dados de acessos</h5>
    </div>
    <div class="card-body">
      <%= form_for @coleta, url: coleta_mensal_atualizar_path do |f| %>
        <%= f.hidden_field :id, :value => @coleta.id %>
        <%= f.hidden_field :uf, :value => @coleta.uf %>
        <%= f.hidden_field :cidade, :value => @coleta.cidade %>
        <%= f.hidden_field :codigoIBGE, :value => @coleta.codigoIBGE %>
        <%= f.hidden_field :mes, :value => @coleta.mes %>
        <%= f.hidden_field :ano, :value => @coleta.ano %>
        <%= f.hidden_field :tituloColeta, :value => @coleta.tituloColeta %>
        <%= f.hidden_field :tipoColeta, :value => @coleta.tipoColeta %>
        <%= f.hidden_field :project_id, :value => @coleta.project_id %>
        <%= f.hidden_field :semestre, :value => @coleta.semestre %>

        <div class="row mb-3">
          <div class="col-md-6">
            <%= f.label :cnpj, "CNPJ", class: "form-label" %>
            <%= f.text_field :cnpj, class: "form-control", id: "cnpj", placeholder: "Digite o CNPJ da Prestadora", required: true, maxlength: 14, oninput: "this.value = this.value.replace(/[^0-9]/g, '')" %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <%= f.label :mesInformado, "Mês", class: "form-label" %>
            <%= f.select :mesInformado, options_for_select((1..12).map { |m| [m, m] }, @coleta.mesInformado), {}, class: 'form-control', required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :anoInformado, "Ano", class: "form-label" %>
            <%= f.select :anoInformado, options_for_select([2023, 2024, 2025], @coleta.anoInformado), {}, class: 'form-control', required: true %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <%= f.label :uf, "UF selecionada", class: "form-label" %>
            <%= f.text_field :uf, class: "form-control", id: "uf", disabled: true, required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :cidade, "Cidade selecionada", class: "form-label" %>
            <%= f.text_field :cidade, class: "form-control", id: "cidade", disabled: true, required: true %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <%= f.label :tipoCliente, "Tipo de Cliente", class: "form-label" %>
            <%= f.select :tipoCliente, options_for_select([['PF', 'Pessoa Física'], ['PJ', 'PJ'], ['UP', 'UP']], @coleta.tipoCliente), {}, class: 'form-control', required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :codigoIBGE, "Código IBGE", class: "form-label" %>
            <%= f.text_field :codigoIBGE, class: "form-control", id: "codigoIBGE", placeholder: "Código IBGE", disabled: true, required: true %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <%= f.label :tipoMeio, "Tipo de Meio", class: "form-label" %>
            <%= f.select :tipoMeio, options_for_select([['Selecione um meio', 'Selecione um meio'], ['cabo_coaxial', 'cabo_coaxial'], ['cabo_metalico', 'cabo_metalico'], ['radio', 'radio'], ['fibra', 'fibra']], @coleta.tipoMeio), {}, class: 'form-control', id: 'tipoMeio', required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :tipoTecnologia, "Tipo de Tecnologia", class: "form-label" %>
            <%= f.select :tipoTecnologia, options_for_select(@coleta.tipoTecnologia.present? ? [[@coleta.tipoTecnologia, @coleta.tipoTecnologia]] : []), {}, class: 'form-control', id: 'tipoTecnologia', required: true %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <%= f.label :quantidadeAcesso, "Quantidade", class: "form-label" %>
            <%= f.text_field :quantidadeAcesso, class: "form-control", id: "quantidadeAcesso", placeholder: "Quantidade", required: true, pattern: "[0-9]*", title: "Este campo só pode conter números.", oninput: "this.value = this.value.replace(/[^0-9]/g, ''); showAlert()" %>
            <small id="quantidadeAcessoAlert" style="color: red; display: none;">Apenas números são permitidos.</small>
          </div>
        </div>

        <script>
          function showAlert() {
            var input = document.getElementById("quantidadeAcesso");
            var alert = document.getElementById("quantidadeAcessoAlert");
            alert.style.display = input.value.match(/[^0-9]/) ? "inline" : "none";
          }
        </script>

        <div class="d-flex justify-content-end gap-2 mt-4">
          <%= f.submit "Salvar", class: "btn btn-primary" %>
          <%= link_to 'Concluir', cliente_cliente_path, class: 'btn btn-secondary text-white' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<br/><br/>

<div class="container">
  <h4>Lista de Coletas</h4>
  <table class="table table-custom">
    <thead class="thead-light">
      <tr>
        <th scope="col">Cnpj</th>
        <th scope="col">Ano</th>
        <th scope="col">Mês</th>
        <th scope="col">Código IBGE</th>
        <th scope="col">Tipo de Cliente</th>
        <th scope="col">Tipo de Atendimento</th>
        <th scope="col">Tipo Meio</th>
        <th scope="col">Quantidade</th>
      </tr>
    </thead>
    <tbody>
      <% @coletas.each do |coleta| %>
        <tr>
          <td><%= coleta.cnpj %></td>
          <td><%= coleta.anoInformado %></td>
          <td><%= coleta.mesInformado %></td>
          <td><%= coleta.codigoIBGE %></td>
          <td><%= coleta.tipoCliente %></td>
          <td><%= coleta.tipoAtendimento %></td>
          <td><%= coleta.tipoMeio %></td>
          <td><%= coleta.quantidadeAcesso %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tecnologiaPorMeio = {
      cabo_coaxial: ['Cable Modem', 'HFC'],
      cabo_metalico: ['XDSL', 'PLC', 'ETHERNET'],
      radio: ['LTE/4G', 'Wi-Fi', 'WFA'],
      fibra: ['FTTH', 'Ethernet']
    };

    const tipoMeioSelect = document.getElementById('tipoMeio');
    const tipoTecnologiaSelect = document.getElementById('tipoTecnologia');

    tipoMeioSelect.addEventListener('change', (event) => {
      const meioSelecionado = event.target.value;
      const opcoesSelect = tecnologiaPorMeio[meioSelecionado] || ['Selecione uma tecnologia'];

      tipoTecnologiaSelect.innerHTML = '<option value="">Selecione uma tecnologia</option>';
      opcoesSelect.forEach(tecnologia => {
        tipoTecnologiaSelect.innerHTML += `<option value="${tecnologia}">${tecnologia}</option>`;
      });
    });
  });
</script>
