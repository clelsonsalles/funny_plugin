<div class="container my-4">
  <div class="card shadow-sm border border-primary">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0"><%= @coleta.tipoColeta %></h5>
    </div>
    <div class="card-body">
      <p class="text-muted mb-4">Coleta de dados de acessos:</p>

      <%= form_for @coleta, url: coleta_mensal_atualizar_path do |f| %>
        <%= f.hidden_field :id, value: @coleta.id %>
        <%= f.hidden_field :uf, value: @coleta.uf %>
        <%= f.hidden_field :cidade, value: @coleta.cidade %>
        <%= f.hidden_field :codigoIBGE, value: @coleta.codigoIBGE %>
        <%= f.hidden_field :mes, value: @coleta.mes %>
        <%= f.hidden_field :ano, value: @coleta.ano %>
        <%= f.hidden_field :tituloColeta, value: @coleta.tituloColeta %>
        <%= f.hidden_field :tipoColeta, value: @coleta.tipoColeta %>
        <%= f.hidden_field :project_id, value: @coleta.project_id %>
        <%= f.hidden_field :semestre, value: @coleta.semestre %>

        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :cnpj, "CNPJ", class: "form-label" %>
            <%= f.text_field :cnpj, class: "form-control", id: "cnpj", placeholder: "Digite o CNPJ da Prestadora", required: true, maxlength: 14, oninput: "this.value = this.value.replace(/[^0-9]/g, '')" %>
          </div>
          <div class="col-md-3">
            <%= f.label :mesInformado, "Mês", class: "form-label" %>
            <%= f.select :mesInformado, options_for_select((1..12).map { |m| [m.to_s, m.to_s] }, @coleta.mesInformado), {}, class: "form-select", required: true %>
          </div>
          <div class="col-md-3">
            <%= f.label :anoInformado, "Ano", class: "form-label" %>
            <%= f.select :anoInformado, options_for_select([2023, 2024, 2025], @coleta.anoInformado), {}, class: "form-select", required: true %>
          </div>
        </div>

        <div class="row g-3 mt-3">
          <div class="col-md-6">
            <%= f.label :uf, "UF selecionada", class: "form-label" %>
            <%= f.text_field :uf, class: "form-control", id: "uf", disabled: true, required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :cidade, "Cidade selecionada", class: "form-label" %>
            <%= f.text_field :cidade, class: "form-control", id: "cidade", disabled: true, required: true %>
          </div>
        </div>

        <div class="row g-3 mt-3">
          <div class="col-md-6">
            <%= f.label :tipoCliente, "Tipo de Cliente", class: "form-label" %>
            <%= f.select :tipoCliente, options_for_select([['PF', 'Pessoa Física'], ['PJ', 'PJ'], ['UP', 'UP']], @coleta.tipoCliente), {}, class: "form-select", required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :codigoIBGE, "Código IBGE", class: "form-label" %>
            <%= f.text_field :codigoIBGE, class: "form-control", id: "codigoIBGE", disabled: true, required: true %>
          </div>
        </div>

        <div class="row g-3 mt-3">
          <div class="col-md-6">
            <%= f.label :tipoMeio, "Tipo de Meio", class: "form-label" %>
            <%= f.select :tipoMeio, options_for_select([['Selecione um meio', 'Selecione um meio'], ['cabo_coaxial', 'cabo_coaxial'], ['cabo_metalico', 'cabo_metalico'], ['radio', 'radio'], ['fibra', 'fibra']], @coleta.tipoMeio), {}, class: "form-select", id: "tipoMeio", required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :tipoTecnologia, "Tipo de Tecnologia", class: "form-label" %>
            <%= f.select :tipoTecnologia, options_for_select([], @coleta.tipoTecnologia), {}, class: "form-select", id: "tipoTecnologia", required: true %>
          </div>
        </div>

        <div class="row g-3 mt-3">
          <div class="col-md-6">
            <%= f.label :quantidadeAcesso, "Quantidade", class: "form-label" %>
            <%= f.text_field :quantidadeAcesso, class: "form-control", id: "quantidadeAcesso", placeholder: "Quantidade", required: true, pattern: "[0-9]*", title: "Este campo só pode conter números.", oninput: "this.value = this.value.replace(/[^0-9]/g, '')" %>
            <small id="quantidadeAcessoAlert" class="form-text text-danger d-none">Apenas números são permitidos.</small>
          </div>
        </div>

        <div class="row mt-4">
          <div class="col-md-6">
            <%= f.submit "Adicionar", class: "btn btn-success w-100" %>
          </div>
          <div class="col-md-6">
            <%= link_to 'Concluir', cliente_cliente_path, class: 'btn btn-secondary w-100' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>







