<div class="container-md">
              <%= form_for @coleta, url: coleta_semestral_salvar_path do |f| %>
                   <%= f.hidden_field :id, :value => @coleta.id %>
                   <%= f.hidden_field :ano, :value => @coleta.ano %>
                   <%= f.hidden_field :semestre, :value => @coleta.semestre %>
                   <%= f.hidden_field :tituloColeta, :value => @coleta.tituloColeta %>
                   <%= f.hidden_field :tipoColeta, :value => @coleta.tipoColeta %>
                   <%= f.hidden_field :project_id, :value => @coleta.project_id %>

                    <div class="box-title"><%= @coleta.tipoColeta %></div>
                         
                       <div class="row mb-3">
                         <div class="col-md-6">
                              <p><%= f.label :cnpj, "CNPJ", class: "form-label" %></p>
                              <p><%= f.text_field :cnpj, class: "form-control", id: "cnpj", 
                                      placeholder: "Digite o CNPJ da Prestadora", required: true,
                                      maxlength: 14, oninput: "this.value = this.value.replace(/[^0-9]/g, '')" %></p>
                         </div>
                      
                         <div class="col-md-6">
                          <p><%= f.label :anoInformado, "Ano", class: "form-label" %></p>
                          <p><%= f.select :anoInformado, options_for_select([['2023', '2023'], ['2024', '2024'], ['2025', '2025']]), required: true %></p>
                         </div>
                       </div>

                      <div class="row mb-3">
                        <div class="col-md-6">
                          <p><%= f.label :trimestre, "Trimestre", class: "form-label" %></p>
                          <p><%= f.select :trimestre, options_for_select([['1', 1], ['2', 2], ['3', 3], ['4', 4]]), required: true %></p>
                        </div>
                        <div class="col-md-6">
                          <p><%= f.label :uf, "Selecione a UF" %></p>
                              <p><%= f.select :uf, options_for_select([['AC', 'AC'], ['AL', 'AL'], ['AP', 'AP'], ['AM', 'AM'], ['BA', 'BA'], ['CE', 'CE'], ['DF', 'DF'], ['ES', 'ES'], ['GO', 'GO'], ['MA', 'MA'], ['MT', 'MT'],['MS', 'MS'], ['MG', 'MG'], ['PA', 'PA'], ['PB', 'PB'], ['PR', 'PR'], ['PE', 'PE'], ['PI', 'PI'], ['RJ', 'RJ'], ['RN', 'RN'], ['RS', 'RS'], ['RO', 'RO'], ['RR', 'RR'], ['SC', 'SC'], ['SP', 'SP'], ['SE', 'SE'], ['TO', 'TO']]), required: true %></p>
                        </div>
                      </div>

                     <div class="row mb-3">
                       <div class="col-md-6">
                          <p><%= f.label :dadoInformado, "Dado Informado", class: "form-label" %></p>
                          <p><%= f.select :dadoInformado, options_for_select([['Receita_Operacional_Líquida_ROL', 'Receita_Operacional_Líquida_ROL'], ['Capital_Expenditure_CAPEX', 'Capital_Expenditure_CAPEX'], ['Tráfego_Dados_Total_MB', 'Tráfego_Dados_Total_MB'], ['Tráfego_Voz_Minutos','Tráfego_Voz_Minutos']]), required: true %></p>
                        </div>


                      <div class="col-md-6">
  <p><%= f.label :valor, "Valores", class: "form-label" %></p>
  <p>
    <%= f.text_field :valor, class: "form-control", id: "valor", 
        placeholder: "Digite um valor", required: true, 
        title: "Este campo só pode conter números decimais com vírgula.", 
        oninput: "this.value = this.value.replace(/[^0-9,]/g, '').replace(/(,.*?),/g, '$1'); showAlert()" %>
  </p>
  <small id="valorAlert" style="color: red; display: none;">Apenas números e uma única vírgula são permitidos.</small>
</div>

<script>
  function showAlert() {
    var input = document.getElementById("valor");
    var alert = document.getElementById("valorAlert");

    if (input.value.match(/[^0-9,]/) || (input.value.match(/,/g) || []).length > 1) {
      alert.style.display = "inline";
    } else {
      alert.style.display = "none";
    }
  }
</script>


                         
                      
                     </div>

                    <div class="row mb-3">


                    <div class="col-md-6">
                          <p><%= f.label :cn, "CN", class: "form-label" %></p>
                          <p>
                            <%= f.text_field :cn, class: "form-control", id: "cn", 
                                placeholder: "CN", required: true, 
                                pattern: "[0-9]*", title: "Este campo só pode conter números.", 
                                oninput: "this.value = this.value.replace(/[^0-9]/g, ''); showAlert()" %>
                          </p>
                          <small id="cnAlert" style="color: red; display: none;">Apenas números são permitidos.</small>
                        </div>

                          <script>
                            function showAlert() {
                              var input = document.getElementById("cn");
                              var alert = document.getElementById("cnAlert");
                              
                              if (input.value.match(/[^0-9]/)) {
                                alert.style.display = "inline";
                              } else {
                                alert.style.display = "none";
                              }
                            }
                          </script>

                  
  
                     
                      
                    </div>

                     <div class="row mb-3">
                       <div class="col-md-6">
                          <%= f.submit "Salvar", class:" btn btn-primary" %>
                        </div>
                        
                       </div>
                       
               <% end %>

                    

  </div>
  

 <br/><br/>
