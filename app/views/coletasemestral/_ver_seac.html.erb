<div class="container mt-4">
  <h4 class="mb-3">Lista de Coletas</h4>
  <div class="table-responsive">
    <table class="table table-striped table-bordered table-hover">
      <thead class="thead-light">
        <tr>
          <th scope="col">CNPJ</th>
          <th scope="col">Ano</th>
          <th scope="col">Trimestre</th>
          <th scope="col">UF</th>
          <th scope="col">Dado Informado</th>
          <th scope="col">Valores</th>
          <th scope="col" colspan="2" class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @coletas.each do |coleta| %>
          <tr>
            <td><%= coleta.cnpj %></td>
            <td><%= coleta.anoInformado %></td>
            <td><%= coleta.trimestre %></td>
            <td><%= coleta.uf %></td>
            <td><%= coleta.dadoInformado %></td>
            <td><%= coleta.valor %></td>
            <td class="text-center">
              <%= form_for coleta, url: coleta_mensal_editar_path do |f| %>
                <%= f.hidden_field :id_coleta, :value => coleta.id %>
                <%= button_tag 'Editar', type: 'submit', class: 'btn btn-danger text-white'%>
              <% end %>
            </td>
            <td class="text-center">
              <%= form_for coleta, url: coleta_mensal_excluir_path do |f| %>
                <%= f.hidden_field :id_coleta, :value => coleta.id %>
                <%= button_tag 'Excluir', type: 'submit', class: 'btn btn-danger text-white', data: { confirm: 'Tem certeza que deseja excluir?' } %>
                
              <% end %>


            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>






<div class="container">
  <h4> Lista de Coletas</h4>
