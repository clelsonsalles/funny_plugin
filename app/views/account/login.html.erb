<style>
  html, body {
    height: 100%;
    margin: 0;
  }

  .login-container {
    height: 100vh;
  }

  .login-right {
    max-width: 400px;
    width: 100%;
  }
</style>

<div class="container-fluid login-container d-flex align-items-center justify-content-center">
  <div class="row w-100">
    <!-- Lado esquerdo -->
    <div class="col-md-6 d-flex flex-column justify-content-center align-items-center login-left text-center p-5">
      <h1 class="login-title">eColeta</h1>
      <h3 class="login-subtitle">Sistema eletrônico para qualificação dos dados e integração com o sistema Coleta de Dados Anatel</h3>
    </div>

    <!-- Lado direito com formulário centralizado -->
    <div class="col-md-6 d-flex justify-content-center align-items-center p-5">
      <div class="login-right p-5">
        <div id="login-form">
          <%= form_tag(signin_path, onsubmit: 'return keepAnchorOnSignIn(this);') do %>
            <%= back_url_hidden_field_tag %>

            <h2>Login</h2>
            <p>Insira seus dados para entrar no sistema</p>

            <div class="form-group">
              <label class="form-label" for="username"><%= l(:field_login) %></label>
              <%= text_field_tag 'username', params[:username], class: "form-control", tabindex: '1', autofocus: params[:username].blank? %>
            </div>

            <div class="form-group">
              <label class="form-label" for="password"><%= l(:field_password) %></label>
              <%= password_field_tag 'password', nil, class: "form-control", tabindex: '2', autofocus: params[:username].present? %>
            </div>

            <% if Setting.lost_password? %>
              <div class="mt-2">
                <%= link_to l(:label_password_lost), lost_password_path, class: "text-muted small" %>
              </div>
            <% end %>

            <% if Setting.autologin? %>
              <div class="form-check mt-3">
                <%= check_box_tag 'autologin', 1, false, class: "form-check-input", id: "autologin" %>
                <label class="form-check-label" for="autologin"><%= l(:label_stay_logged_in) %></label>
              </div>
            <% end %>

            <button type="submit" name="login" class="btn btn-dark w-100 mt-4" tabindex="5" id="login-submit">
              <%= l(:button_login) %>
            </button>
          <% end %>

          <div class="login-footer">
            <p class="mt-4">É novo por aqui? <a href="/account/register">Criar conta</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>







